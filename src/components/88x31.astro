---
import Image from 'astro/components/Image.astro';

interface Props {
    src?: string | ImageMetadata | Promise<{ default: ImageMetadata; }>;
    picture?: {
        [mime: `image/${string}`]: string;
        fallback: string;
    },
    title?: string;
    href?: string;
    alt?: string;
}
const { src, picture, href, title, alt } = Astro.props;
---

{src
    ? typeof src === 'string'
        ? href
            ? <a href={href}><Image src={src} title={title ?? alt} alt={alt ?? null} width={88} height={31} /></a>
            : <Image src={src} title={title ?? alt} alt={alt ?? null} width={88} height={31} />
        : href
            ? <a href={href}><Image src={src} title={title ?? alt} alt={alt ?? null} /></a>
            : <Image src={src} title={title ?? alt} alt={alt ?? null} />
    : picture
        ? href
            ? <a href={href}>
                <picture>
                    {Object.entries(picture)
                        .filter(([mime]) => mime !== 'fallback')
                        .map(([mime, src]) => (
                            <source srcset={src} type={mime} />
                        ))}
                    <Image src={picture.fallback} title={title ?? alt} alt={alt ?? null} width={88} height={31} />
                </picture>
            </a>
            : <picture>
                {Object.entries(picture)
                    .filter(([mime]) => mime !== 'fallback')
                    .map(([mime, src]) => (
                        <source srcset={src} type={mime} />
                    ))}
                <Image src={picture.fallback} title={title ?? alt} alt={alt ?? null} width={88} height={31} />
            </picture>
        : null
}